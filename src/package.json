{
  "name": "sen",
  "version": "0.1.0",
  "description": "A JS-first, Roblox-style API that wraps shadcn/ui. No JSX, no state wiring.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/sen.js",
  "module": "./dist/sen.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sen.js",
      "default": "./dist/sen.js"
    },
    "./global": "./dist/sen.global.js"
  },
  "bin": {
    "sen-eject": "./eject.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "eject.mjs"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "components:sync": "node scripts/sync-component-catalog.mjs",
    "components:new": "node scripts/new-component.mjs",
    "components:discover": "node scripts/discover-external-components.mjs",
    "build": "vite build && vite build --mode global && tsc -p tsconfig.build.json",
    "build:js": "vite build && vite build --mode global",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "install:sen": "node install.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
